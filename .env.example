# ==============================================================================
# one-api — Environment Configuration
# ==============================================================================

# --- Server Settings ---
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
ENABLE_COMPRESSION=true

# --- Gateway Security & Access ---
# Set a master API key to protect your gateway with Bearer authentication
# ONE_API_KEY=your-secret-master-key-here
# ALLOWED_ORIGINS=https://yourdomain.com, http://localhost:3000
# RATE_LIMIT_RPM=120

# --- In-Memory Caching ---
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=1000

# --- Upstream Provider Credentials ---
# Leave empty or omit any providers you do not use.
# one-api seamlessly falls back to local zero-config generation when keys are omitted.

# OpenAI
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Google Gemini
GOOGLE_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# DeepSeek
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Groq Cloud
GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Mistral AI
MISTRAL_API_KEY=
# MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Together AI
TOGETHER_API_KEY=
# TOGETHER_BASE_URL=https://api.together.xyz/v1

# Ollama / Local Inference
OLLAMA_BASE_URL=http://localhost:11434
