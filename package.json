{
  "name": "@shenald/one-api",
  "version": "3.0.0",
  "description": "One API to rule them all. Universal Edge LLM Gateway & Distributed Agent Runtime for 20+ providers. Native MCP Server, SSE streaming, hybrid semantic cache, deterministic flight recorder & zero config.",
  "main": "src/index.js",
  "bin": {
    "one-api": "bin/cli.js"
  },
  "files": [
    "bin",
    "src",
    "public",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/index.js --server",
    "dev": "node --watch src/index.js --server",
    "test": "node tests/test.js && node --test tests/*.test.js",
    "benchmark": "node benchmarks/run.js",
    "doctor": "node src/index.js doctor",
    "chat": "node src/index.js chat",
    "mcp": "node src/index.js --mcp",
    "docker:build": "docker build -t shenald/one-api .",
    "docker:run": "docker run -p 3000:3000 shenald/one-api"
  },
  "keywords": [
    "llm",
    "api-gateway",
    "model-context-protocol",
    "mcp-server",
    "openai",
    "anthropic",
    "gemini",
    "deepseek",
    "groq",
    "ollama",
    "distributed-tracing",
    "semantic-cache",
    "unified-api",
    "vibe-coder"
  ],
  "author": "shenald.dev",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shenald-dev/one-api.git"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
